# Hermes runtime configuration.
#
# Copy to `.env.local` and fill in. WITHOUT ANY OF THESE the app still runs:
# the runtime reports `live: false`, operational screens show SIMULATION, and
# agent messages are stored as `awaiting-runtime` rather than answered.
#
# Never commit real values. `.env.local` is gitignored.

# ── Provider selection ────────────────────────────────────────────────────
# Optional. Forces a provider; otherwise the best available one is chosen:
# minimax (if AI_API_KEY is set) → cortex (if CORTEX_BASE_URL is set) → none.
#   AI_PROVIDER=minimax | cortex | none
# AI_PROVIDER=

# ── Option A: direct to the model (recommended) ───────────────────────────
# Real token streaming, and each agent's own system prompt reaches the model.
# AI_API_KEY=
# AI_MODEL=MiniMax-M3
# AI_BASE_URL=https://api.minimax.io/anthropic

# ── Option B: via the existing Cortex service ─────────────────────────────
# Needs no key here (Cortex holds its own), but note two limitations:
#   - Cortex buffers the whole reply, so there is no token streaming.
#   - Cortex injects its own system prompt, so per-agent identity is weakened.
# CORTEX_BASE_URL=http://127.0.0.1:7833

# ── Limits ────────────────────────────────────────────────────────────────
# AI_MAX_TOKENS=4096
# AI_TIMEOUT_MS=60000
